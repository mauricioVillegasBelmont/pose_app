# ==========================================
# Configuración de la aplicación
# ==========================================
APP_NAME="Pose AR App"
ENVIRONMENT=development
RENDER_DEBUG_OVERLAY=true

# ==========================================
# Cámara
# ==========================================
CAMERA_ID=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_FOURCC=MJPG
# Número de frames en el buffer interno de V4L2 (CAP_PROP_BUFFERSIZE).
# 1 = mínima latencia (default). 2-5 = absorbe picos de pérdida de paquetes
# USB en hardware saturado, a costa de mayor latencia. Solo ajustar si
# frames_corruptos crece rápido Y la cámara está en puerto USB directo.
# NOTA: no todos los drivers lo soportan; si se ignora, no tendrá efecto.
CAMERA_BUFFERSIZE=1
# Proporción mínima de píxeles no-cero para aceptar un frame (0.0-1.0).
# Frames con >(1 - valor) píxeles en cero se descartan como corruptos.
# Default seguro: 0.3. Solo ajustar si tu hardware descarta frames válidos.
CAMERA_MIN_NONZERO_RATIO=0.3

# ==========================================
# Estimación de pose
# ==========================================
POSE_PROVIDER=mediapipe          # mediapipe | mock
POSE_MODEL_COMPLEXITY=1          # 0=rápido, 1=balance, 2=preciso
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5

# ==========================================
# Render
# ==========================================
RENDER_PROVIDER=pygame           # pygame | mock
RENDER_WIDTH=800
RENDER_HEIGHT=600
RENDER_TITLE="Pose AR App"
RENDER_TARGET_FPS=60
RENDER_DEBUG_OVERLAY=false
RENDER_MIRROR=false


# ==========================================
# API
# ==========================================
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000

# ==========================================
# Juego
# ==========================================
GAME_TYPE=particles              # particles | color
GAME_GRAVITY=0.08
GAME_BURST_COUNT=5
GAME_MAX_PARTICLES=2000
GAME_PALETTE=fire                # fire | ocean | forest | neon

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console               # console | json
LOG_FILE=false                   # true → escribe a logs/app.log y logs/errors.log
LOG_DIRECTORY=logs               # directorio de archivos

# ==========================================
# JWT
# ==========================================

JWT_SECRET_KEY=tu-clave-super-secreta-de-al-menos-32-chars-aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
