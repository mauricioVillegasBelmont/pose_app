{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/README.md",
    "docs/guides/system_learning.md",
    "docs/contracts/ports_contract.md",
    "docs/architecture/render_architecture.md",
    "docs/contracts/code_style.md"
  ],
  "permission": {
    "read": "allow",
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "allow",
      "rm:*": "deny",
      "rmdir:*": "deny",
      "git reset:*": "deny",
      "git clean:*": "deny",
      "git checkout -- *": "deny",
      "git push:*": "deny",
      "git commit:*": "ask",
      "mv:*": "ask",
      "cp:*": "ask"
    },
    "external_directory": "ask"
  }
}
